  "item": [
    {
      "name": "Owner - Register",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\",\n  \"display_name\": \"{{owner_display_name}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/auth/register", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "register" ] }
      },
      "response": []
    },
    {
      "name": "Owner - Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/auth/login", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "login" ] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  pm.environment.set('owner_access_token', json.access_token);",
              "  pm.environment.set('owner_refresh_token', json.refresh_token);",
              "} else {",
              "  console.log('Owner login returned', pm.response.code);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Owner - Me",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{owner_access_token}}" } ],
        "url": { "raw": "{{base_url}}/api/auth/me", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "me" ] }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('me returns 200', function(){pm.response.to.have.status(200);});", "var json = pm.response.json();", "pm.environment.set('owner_user_id', json.id);" ] } } ],
      "response": []
