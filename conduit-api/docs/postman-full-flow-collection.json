    {
      "name": "Moderator ejects victim",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{moderator_access_token}}" } ],
        "url": { "raw": "{{base_url}}/api/groups/{{group_moderator_id}}/memberships/{{victim_user_id}}", "host": [ "{{base_url}}" ], "path": [ "api", "groups", "{{group_moderator_id}}", "memberships", "{{victim_user_id}}" ] }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('eject returned 200', function(){pm.response.to.have.status(200);});", "// verify victim no longer in members", "pm.sendRequest({ url: pm.environment.get('base_url') + '/api/groups/' + pm.environment.get('group_moderator_id') + '/memberships', method: 'GET', header: { 'Authorization': 'Bearer ' + pm.environment.get('owner_access_token') } }, function(err, res) { var arr = res.json(); var found = arr.some(function(m){ return m.user_id == parseInt(pm.environment.get('victim_user_id')); }); pm.test('victim removed', function(){pm.expect(found).to.be.false;}); });" ] } } ],
      "response": []
    },

