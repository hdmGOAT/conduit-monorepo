    {
      "name": "Owner adds moderator and victim to moderator group",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{owner_access_token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"user_id\": {{moderator_user_id}},\n  \"role\": \"moderator\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/groups/{{group_moderator_id}}/memberships", "host": [ "{{base_url}}" ], "path": [ "api", "groups", "{{group_moderator_id}}", "memberships" ] }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('add moderator ok', function(){pm.response.to.have.status(200);});" ] } } ],
      "response": []
    },
    {
      "name": "Owner adds victim to moderator group",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{owner_access_token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"user_id\": {{victim_user_id}},\n  \"role\": \"member\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/groups/{{group_moderator_id}}/memberships", "host": [ "{{base_url}}" ], "path": [ "api", "groups", "{{group_moderator_id}}", "memberships" ] }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('add victim ok', function(){pm.response.to.have.status(200);});" ] } } ],
      "response": []
