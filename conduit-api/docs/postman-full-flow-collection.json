        "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/groups/{{group_closed_id}}/join", "host": [ "{{base_url}}" ], "path": [ "api", "groups", "{{group_closed_id}}", "join" ] }
