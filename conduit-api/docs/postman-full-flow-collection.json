        "url": { "raw": "{{base_url}}/api/groups", "host": [ "{{base_url}}" ], "path": [ "api", "groups" ] }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('create closed group ok', function(){pm.response.to.have.status(200);});", "var json = pm.response.json();", "pm.environment.set('group_closed_id', json.id);" ] } } ],
