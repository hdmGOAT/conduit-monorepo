      "name": "Owner lists join requests (closed)",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{owner_access_token}}" } ],
        "url": { "raw": "{{base_url}}/api/groups/{{group_closed_id}}/join-requests", "host": [ "{{base_url}}" ], "path": [ "api", "groups", "{{group_closed_id}}", "join-requests" ] }
