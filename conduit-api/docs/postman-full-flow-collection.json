    { "name": "Member - Me", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{member_access_token}}" } ], "url": { "raw": "{{base_url}}/api/auth/me", "host": [ "{{base_url}}" ], "path": [ "api", "auth", "me" ] } }, "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('me returns 200', function(){pm.response.to.have.status(200);});", "var json = pm.response.json();", "pm.environment.set('member_user_id', json.id);" ] } } ], "response": [] },

