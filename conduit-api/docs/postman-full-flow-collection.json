      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('list join requests ok', function(){pm.response.to.have.status(200);});", "var arr = pm.response.json();", "var found = arr.some(function(j){ return j.user_id == parseInt(pm.environment.get('member_user_id')); });", "pm.test('member join request exists', function(){pm.expect(found).to.be.true;});" ] } } ],
      "response": []
    },

    {
      "name": "Owner approves join request (closed)",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{owner_access_token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\",\n  \"role\": \"member\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/groups/{{group_closed_id}}/join-requests/{{member_user_id}}", "host": [ "{{base_url}}" ], "path": [ "api", "groups", "{{group_closed_id}}", "join-requests", "{{member_user_id}}" ] }
